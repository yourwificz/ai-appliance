# Container images.
#
# For reproducible releases, replace :latest with an explicitly tested
# version tag or immutable image digest.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:latest
SEARXNG_IMAGE=docker.io/searxng/searxng:latest

# Published container ports.
OPEN_WEBUI_PORT=3000
SEARXNG_PORT=8081

# Persistent host storage.
OPEN_WEBUI_DATA_DIR=/mnt/ai-data/openwebui
SEARXNG_CONFIG_DIR=/mnt/ai-data/searxng

# Ollama connection.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Public addresses.
WEBUI_URL=https://ai.yourwifi.cz
SEARXNG_BASE_URL=https://search.yourwifi.cz/

# WebUI instance secret.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-new-long-random-secret

# SearXNG instance secret.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-long-random-secret

# Microsoft Entra ID application registration.
MICROSOFT_CLIENT_ID=replace-with-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_CLIENT_TENANT_ID=replace-with-tenant-id

# Authentication.
ENABLE_OAUTH_SIGNUP=true
ENABLE_OAUTH_PERSISTENT_CONFIG=false

# Preserve settings changed through the Open WebUI Admin UI.
ENABLE_PERSISTENT_CONFIG=true

# Stable encryption keys for OAuth sessions and MCP OAuth client registrations.
# Generate each independently with: openssl rand -hex 32
OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
OAUTH_CLIENT_INFO_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Web search.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=10
WEB_LOADER_CONCURRENT_REQUESTS=10

# Temporary workaround: result snippets only, without full-page loading.
BYPASS_WEB_SEARCH_WEB_LOADER=true

# Internal container-to-container URL.
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>

# SearXNG instance secret.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-long-random-secret
